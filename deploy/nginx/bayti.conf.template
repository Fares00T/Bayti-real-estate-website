# Bayti on one VPS: three static front ends and the API behind Nginx.
# setup-server.sh replaces __DOMAIN__ and installs this as
# /etc/nginx/sites-available/bayti. Certbot then adds HTTPS to every block.
#
#   __DOMAIN__          marketplace  (client/dist)
#   www.__DOMAIN__      redirects to __DOMAIN__
#   agency.__DOMAIN__   agency workspace (agency/dist)
#   admin.__DOMAIN__    admin dashboard  (admin/dist)
#   api.__DOMAIN__      Express API on 127.0.0.1:8800 (PM2)

# ---------- API ----------
server {
    listen 80;
    listen [::]:80;
    server_name api.__DOMAIN__;

    # Up to 10 files of 10 MB per request (api/lib/storage.js)
    client_max_body_size 110m;

    location / {
        proxy_pass http://127.0.0.1:8800;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ---------- Marketplace ----------
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    root /var/www/bayti/client;
    include /etc/nginx/snippets/bayti-spa.conf;
}

server {
    listen 80;
    listen [::]:80;
    server_name www.__DOMAIN__;
    return 301 $scheme://__DOMAIN__$request_uri;
}

# ---------- Agency workspace ----------
server {
    listen 80;
    listen [::]:80;
    server_name agency.__DOMAIN__;
    root /var/www/bayti/agency;
    include /etc/nginx/snippets/bayti-spa.conf;
}

# ---------- Admin dashboard ----------
server {
    listen 80;
    listen [::]:80;
    server_name admin.__DOMAIN__;
    root /var/www/bayti/admin;
    include /etc/nginx/snippets/bayti-spa.conf;

    # Optional: let only your own IP addresses reach the dashboard.
    # allow 203.0.113.10;
    # deny all;
}
