# Production api/.env. setup-server.sh writes this file on the server with
# real values (database password and JWT secrets generated there). This copy
# only documents what goes in it; never commit the real one.

NODE_ENV=production
PORT=8800

# MySQL on the same server (user and password created by setup-server.sh)
DATABASE_URL="mysql://bayti:CHANGE_ME@localhost:3306/bayti"

# Three different long random strings (openssl rand -hex 48)
JWT_SECRET_KEY=""
ADMIN_JWT_SECRET=""
AGENCY_JWT_SECRET=""

# The three front ends. The API only accepts logged-in requests from these
# exact origins, and uses them in email links.
CLIENT_URL="https://bayti.com"
AGENCY_URL="https://agency.bayti.com"
ADMIN_URL="https://admin.bayti.com"

# Private uploads (legal documents, report screenshots), outside any web root
STORAGE_DIR="/srv/bayti/storage/private"

# Outgoing email through Gmail: the address and a Google "App password"
# (Google account > Security > 2-Step Verification > App passwords).
EMAIL_USER=""
EMAIL_PASS=""
